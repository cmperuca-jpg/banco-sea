{
  "name": "fusion-sistema",
  "version": "3.0.0-beta.7",
  "description": "Fusion Sistema — aplicação local, PWA e sincronização Supabase",
  "private": true,
  "type": "module",
  "main": "desktop/electron-main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "configurar:supabase-novo": "node scripts/configurar-supabase-novo.mjs",
    "check": "node scripts/verificar-projeto.mjs",
    "reset:virgem": "node scripts/resetar-sistema-virgem.mjs",
    "reset:simular": "node scripts/resetar-sistema-virgem.mjs --dry-run",
    "reset:admin": "node scripts/reset-admin-password.mjs",
    "render:check": "node scripts/render-smoke-test.mjs",
    "render:start": "NODE_ENV=production node server.mjs",
    "backup:supabase": "node scripts/backup-supabase.mjs",
    "backup:local": "node scripts/backup-local.mjs",
    "backup:data": "node scripts/backup-data.mjs",
    "package:seguro": "node scripts/empacotar-v3.mjs",
    "migrate:supabase": "node scripts/migrar-json-supabase-v3.mjs",
    "migrate:financeiro:simular": "node scripts/migrar-financeiro-ledger-v1.mjs",
    "migrate:financeiro": "node scripts/migrar-financeiro-ledger-v1.mjs --apply",
    "test:financeiro": "node scripts/test-financeiro-ledger.mjs",
    "test:localhost": "node scripts/test-localhost-financeiro.mjs",
    "test:cobranca-automatica": "node scripts/test-cobranca-automatica-http.mjs",
    "test:e2e:desktop": "node tests/e2e-desktop-integral.mjs",
    "reconciliar:financeiro:simular": "node scripts/reconciliar-financeiro-caixa.mjs --supabase",
    "reconciliar:financeiro": "node scripts/reconciliar-financeiro-caixa.mjs --supabase --apply",
    "piloto:280": "npm run check && npm run backup:data",
    "access:agent": "node scripts/fusion-access-agent.mjs",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder --win nsis",
    "desktop:publish": "electron-builder --win nsis --publish always",
    "build:installer": "npm run desktop:dist",
    "desktop:verify-dist": "node scripts/verificar-distribuicao-desktop.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.0.5",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.fusionsistema.desktop",
    "productName": "Fusion Sistema",
    "artifactName": "FusionSistema-Setup.${ext}",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "server.mjs",
      "package.json",
      "config/**/*",
      "core/**/*",
      "lib/**/*",
      "modules/**/*",
      "!public/**/*",
      "scripts/**/*",
      "desktop/**/*",
      "!desktop/assets/icon-source.png",
      "!**/*.map",
      "!**/*.log",
      "!**/*.zip",
      "!docs/**/*",
      "!supabase/**/*",
      "!data/**/*",
      "!uploads/**/*",
      "!backups/**/*",
      "!logs/**/*",
      "!.env*",
      "!.git/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fusion Sistema",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cmperuca-jpg",
        "repo": "banco-sea",
        "releaseType": "release"
      }
    ]
  },
  "author": "Fusion Sistema"
}
