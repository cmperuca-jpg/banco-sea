# Fusion Sistema — etapa 1: autenticação no Supabase e dados locais.
# Copie este arquivo para .env. Não publique o arquivo .env no GitHub.

PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FUSION_JSON_BODY_LIMIT=10mb
FUSION_FORM_BODY_LIMIT=2mb

# Autenticação oficial do novo projeto Supabase.
FUSION_AUTH_PROVIDER=supabase
SUPABASE_URL=https://kruujujuxeqexxuugwci.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_qF4Iq7h0meYTGk5CzaG_4w_7QAdkFZC
SUPABASE_ANON_KEY=sb_publishable_qF4Iq7h0meYTGk5CzaG_4w_7QAdkFZC
FUSION_SUPABASE_AUTH_CACHE_MS=30000

# Nesta primeira etapa, os módulos existentes continuam lendo os JSON locais.
# A migração das coleções para as tabelas novas será feita gradualmente.
FUSION_DATABASE_PROVIDER=json
FUSION_JSON_FALLBACK=true
FUSION_MIGRATE_JSON_ON_START=false
FUSION_SYNC_DATA_ON_LOCAL=false
FUSION_REQUIRE_SUPABASE_DATA=false

# Desativados para evitar tráfego e backups automáticos durante a transição.
FUSION_BACKUP_AUTO=false
FUSION_BACKUP_AUTO_ON_LOCAL=false

# Identificação da academia criada no novo Supabase.
FUSION_ACADEMIA_ID=7e6a22a2-c379-4b61-9388-fa951954d079
FUSION_TENANT_ID=academia-fusion-combat-fit

# O serviço da catraca será configurado em uma etapa separada.
ACCESS_AGENT_ID=
ACCESS_AGENT_TOKEN=
ACCESS_SERVER_URL=http://localhost:3000
ACCESS_AGENT_POLL_MS=1500
HENRY_HOST=
HENRY_PORT=3000
